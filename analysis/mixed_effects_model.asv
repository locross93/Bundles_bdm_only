%Initialize workspace
clearvars;
clc;

%Specify script parameters
%which subjects to analyze
subID_cell = {'101','102','103','104','105','106'...
    ,'107','108','109','110','111','112','113','114'}; 

y = [];
X_full = [];
all_subIDs = [];
bundle_ids = [];
bundle_type = {};
for i=1:length(subID_cell)
    subID = subID_cell{i};
    for day=1:3
        subID_day = [subID,'-',num2str(day)];
        temp_file = ['../logs/bdm_items_sub_',subID_day,'.mat'];
        load(temp_file)
        bdm_item_value = value;
        bdm_item = item;
        temp_file = ['../logs/bdm_bundle_sub_',subID_day,'.mat'];
        load(temp_file)
        bdm_bundle_value = value;
        bdm_bundle = item;

        y = [y; bdm_bundle_value];
        X = zeros(length(bdm_bundle_value), 2);
        %create a array of subID to put in table
        subID_array = str2num(subID(2:3))*ones(length(bdm_bundle_value),1);

        for j=1:length(bdm_bundle_value)
            temp_bundle = bdm_bundle(j,:);
            left_item_ind = find(bdm_item == temp_bundle(1));
            X(j,1) = bdm_item_value(left_item_ind);
            right_item_ind = find(bdm_item == temp_bundle(2));
            X(j,2) = bdm_item_value(right_item_ind);
            % what type of bundle is it
            bundle_ids = [bundle_ids; temp_bundle];
            if temp_bundle(1) == temp_bundle(2)
                bundle_type{end+1} = 'Same Item';
            elseif temp_bundle(1) < 100 && temp_bundle(2) < 100
                bundle_type{end+1} = 'Food';
            elseif temp_bundle(1) >= 100 && temp_bundle(2) >= 100
                bundle_type{end+1} = 'Trinket';
            else
                bundle_type{end+1} = 'Mixed';
            end
        end
        X_full = [X_full; X];
        all_subIDs = [all_subIDs; subID_array];
    end
end

%mixed effects analysis while treating subject as a random effect
all_subj_data = table(y,X_full(:,1),X_full(:,2),all_subIDs,bundle_type','VariableNames',{'BundleValue','LItemValue','RItemValue','Subject','Type'});
%lme = fitlme(tbl,'BundleValue ~ 1 + LItemValue + RItemValue + (1|Subject)')
%lme = fitlme(all_subj_data,'BundleValue ~ 1 + LItemValue + RItemValue + (RItemValue|Subject) + (LItemValue|Subject) + (1|Subject)');
% omit intercept from random-effect slope terms
lme = fitlme(all_subj_data,'BundleValue ~ 1 + LItemValue + RItemValue + (-1 + RItemValue|Subject) + (-1 + LItemValue|Subject) + (1|Subject)');

%LM_leftright=fitlm(X_full,y,'VarNames',{'LeftItemValue','RightItemValue','BundleValue'},'Intercept',0)

%writetable(all_subj_data,'all_subj_data.csv');

%plot individual subject params vs average
[B,Bnames,stats] = randomEffects(lme);
coefs = lme.Coefficients.Estimate;
figure
b = bar(1:3,coefs,'r');
hold on
scatter(1*ones(14,1),B(29:42)+coefs(1),'b')
scatter(2*ones(14,1),B(15:28)+coefs(2),'b')
scatter(3*ones(14,1),B(1:14)+coefs(3),'b')
names = {'Intercept','Beta: Item 1','Beta: Item 2'};
set(gca,'xtick',[1:3],'xticklabel',names,'FontSize',16)
ylabel('Coefficient Value')
title(sprintf('Invididual Subject Coefficients'),'FontSize',18)

figure
b = bar(1:2,coefs(2:3),'r');
hold on
%scatter(1*ones(14,1),B(29:42)+coefs(1),'b')
scatter(1*ones(14,1),B(15:28)+coefs(2),'b')
scatter(2*ones(14,1),B(1:14)+coefs(3),'b')
names = {'Beta: Item 1','Beta: Item 2'};
set(gca,'xtick',[1:2],'xticklabel',names,'FontSize',16)
ylabel('Coefficient Value')
title(sprintf('Invididual Subject Coefficients'),'FontSize',18)

figure
b = bar(1,coefs(1),'r');
hold on
scatter(1*ones(14,1),B(29:42)+coefs(1),'b')
%scatter(2*ones(14,1),B(15:28)+coefs(2),'b')
%scatter(3*ones(14,1),B(1:14)+coefs(3),'b')
names = {'Intercept'};
set(gca,'xtick',[1],'xticklabel',names,'FontSize',16)
ylabel('Coefficient Value')
title(sprintf('Invididual Subject Coefficients'),'FontSize',18)

%plot bundle value vs sum of individual values
figure(10);
sum_of_values = sum(X_full,2);
bdm_bundle_value = y;
%plot(sum_of_values,bdm_bundle_value,'.','MarkerSize',20);
binscatter(sum_of_values,bdm_bundle_value,[20 20])
%binscatter(sum_of_values(nz_inds),bdm_bundle_value(nz_inds),[20 20])
%colormap(gca,flipud('hot'))
cmap = flipud(colormap(gca,'pink'));
colormap(cmap);
%colormap(gca,'parula')
hold on
plot((0:.01:20), (0:.01:20),'r','MarkerSize',10);
xlabel('Value of Sum of Individual Item Values','FontSize',16);
ylabel('Bundle Value','FontSize',16);
title(sprintf('Bundle Value vs. Linear Sum'),'FontSize',18);
xlim([0 20])
ylim([0 20]);


%% By type

lme = fitlme(all_subj_data,'BundleValue ~ 1 + LItemValue + RItemValue + (1|Subject)');
designMatrix(lme)
fitlmematrix(all_subj_dta.Bund,y,Z,G)

